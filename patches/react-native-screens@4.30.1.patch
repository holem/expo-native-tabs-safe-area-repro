+    return;
+  }
+  const NSUInteger sample = ++_rns42486FrameSample;
+  const double rnBefore = RNS42486Now();
+  const double caNow = CACurrentMediaTime();
+  const double rnAfter = RNS42486Now();
+  NSArray<NSString *> *nativeStateNames = @[@"rnc-container", @"rnc-marker", @"rnc-child",
+                                           @"rn-core-container", @"rn-core-marker", @"rn-core-child"];
+  NSArray<NSString *> *footerNames = @[@"native-footer", @"native-content", @"js-footer", @"js-content",
+                                      @"animated-static-footer", @"animated-static-content",
+                                      @"animated-worklet-footer", @"animated-worklet-content"];
+  NSString *footerRootID = [NSString stringWithFormat:@"%@-footer-screen", _rns42486FrameRoute];
+  NSString *nativeStateRootID = [NSString stringWithFormat:@"%@-native-state-screen", _rns42486FrameRoute];
