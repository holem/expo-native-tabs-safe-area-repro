+    fixture = @"footer";
+    names = footerNames;
+  } else if (!ambiguousRoot && nativeStateRootPresent && !footerRootPresent) {
+    fixture = @"native-state";
+    names = nativeStateNames;
+  } else if (ambiguousRoot || (footerRootPresent && nativeStateRootPresent)) {
