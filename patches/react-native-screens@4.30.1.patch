+// Use the ancestor from this presentation tree; a separate presentationLayer call may return a copy.
+static CALayer *RNS42486PresentationWindow(CALayer *presentation, CALayer *modelWindow, NSString **status)
+{
+  CALayer *match = nil;
+  CALayer *ancestor = presentation.superlayer;
+  for (NSUInteger depth = 0; ancestor != nil && depth < 256; depth++, ancestor = ancestor.superlayer) {
+    if (ancestor.modelLayer == modelWindow) {
+      if (match != nil) {
+        *status = @"ambiguous-presentation-window";
+        return nil;
+      }
+      match = ancestor;
+    }
+  }
+  if (ancestor != nil) {
+    *status = @"presentation-chain-limit";
+    return nil;
+  }
+  *status = match != nil ? @"available" : @"no-presentation-window-ancestor";
+  return match;
+}
