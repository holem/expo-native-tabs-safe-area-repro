+// This worker receives Foundation snapshots only; it never reads controller/UIKit state.
+static void RNS42486WriteFrameRows(NSArray<NSDictionary *> *rows, NSDictionary *metadata, NSString *name)
+{
+  NSMutableData *body = [NSMutableData data];
+  NSUInteger emitted = 0, oversize = 0, serializationErrors = 0;
+  for (NSDictionary *row in rows) {
+    NSError *error = nil;
+    NSData *data = [NSJSONSerialization dataWithJSONObject:row options:NSJSONWritingSortedKeys error:&error];
+    if (data == nil) {
+      serializationErrors++;
+      continue;
+    }
+    // No text clipping: an oversized row is counted and omitted in full.
+    if (data.length >= 900) {
+      oversize++;
+      continue;
+    }
+    [body appendData:data];
+    [body appendBytes:"\n" length:1];
+    emitted++;
+  }
+  NSUInteger dropped = [metadata[@"capacityDrops"] unsignedIntegerValue] + oversize + serializationErrors;
+  NSMutableDictionary *manifest = [metadata mutableCopy];
+  [manifest addEntriesFromDictionary:@{
+    @"emittedRows" : @(emitted), @"droppedRows" : @(dropped),
+    @"oversizeDrops" : @(oversize), @"serializationErrors" : @(serializationErrors), @"bodyBytes" : @(body.length)
+  }];
+  NSError *error = nil;
+  NSData *header = [NSJSONSerialization dataWithJSONObject:manifest options:NSJSONWritingSortedKeys error:&error];
+  NSMutableData *file = [NSMutableData data];
+  if (header != nil && header.length < 900) {
+    [file appendData:header];
+    [file appendBytes:"\n" length:1];
+    [file appendData:body];
+  }
+  NSURL *documents = [NSFileManager.defaultManager URLForDirectory:NSDocumentDirectory
+                                                        inDomain:NSUserDomainMask
+                                               appropriateForURL:nil create:YES error:&error];
+  NSURL *directory = [documents URLByAppendingPathComponent:@"native-tabs-42486" isDirectory:YES];
+  BOOL madeDirectory = directory != nil && [NSFileManager.defaultManager createDirectoryAtURL:directory
+                                                              withIntermediateDirectories:YES attributes:nil error:&error];
+  NSURL *url = [directory URLByAppendingPathComponent:name];
+  BOOL written = file.length != 0 && madeDirectory && [file writeToURL:url options:NSDataWritingAtomic error:&error];
+  NSLog(@"[native-tabs-42486] frame-file path=%@ rows=%lu expected=%lu dropped=%lu bytes=%lu stop=%@ writeOK=%d error=%@:%ld",
+        url.path ?: @"", (unsigned long)emitted, (unsigned long)[metadata[@"expectedRows"] unsignedIntegerValue],
+        (unsigned long)dropped, (unsigned long)file.length, metadata[@"stopReason"],
+        written, error.domain ?: @"", (long)error.code);
+}
+
+static void RNS42486EnqueueFrameRows(NSArray<NSDictionary *> *rows, NSDictionary *metadata, NSString *name)
+{
+  static dispatch_queue_t queue;
+  static dispatch_semaphore_t slots;
+  static dispatch_once_t once;
+  dispatch_once(&once, ^{
+    queue = dispatch_queue_create("dev.repro.nativetabsinsets.frame-files",
+        dispatch_queue_attr_make_with_qos_class(DISPATCH_QUEUE_SERIAL, QOS_CLASS_UTILITY, 0));
+    slots = dispatch_semaphore_create(8);
+  });
+  // Bound both queued and running batches; never wait for file IO on the UI thread.
+  if (dispatch_semaphore_wait(slots, DISPATCH_TIME_NOW) != 0) {
+    NSLog(@"[native-tabs-42486] frame-file droppedBatches=1 pendingLimit=8 controller=%@ visit=%@ expected=%@ stop=%@",
+          metadata[@"controller"], metadata[@"visit"], metadata[@"expectedRows"], metadata[@"stopReason"]);
+    return;
+  }
+  dispatch_async(queue, ^{
+    @autoreleasepool {
+      RNS42486WriteFrameRows(rows, metadata, name);
+    }
+    dispatch_semaphore_signal(slots);
+  });
+}
 
