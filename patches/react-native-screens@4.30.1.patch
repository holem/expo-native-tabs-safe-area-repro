+  NSMutableSet<NSString *> *duplicates = [NSMutableSet new];
+  NSMutableSet<NSString *> *wanted = [NSMutableSet setWithObjects:footerRootID, nativeStateRootID, nil];
+  for (NSString *name in [footerNames arrayByAddingObjectsFromArray:nativeStateNames]) {
+    [wanted addObject:[NSString stringWithFormat:@"%@-%@", _rns42486FrameRoute, name]];
+  }
+  NSMutableArray<UIView *> *pending = [NSMutableArray new];
